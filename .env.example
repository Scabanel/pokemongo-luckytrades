# Connexion Postgres (Supabase). POSTGRES_PRISMA_URL = pooler transaction
# (port 6543, utilisé par l'app à l'exécution). DIRECT_URL = connexion directe
# (port 5432, utilisée uniquement par `prisma migrate`). Voir README.md.
POSTGRES_PRISMA_URL="postgresql://postgres.[ref]:[password]@[pooler-host]:6543/postgres"
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email du compte admin (comparé à l'email de la session Supabase connectée)
ADMIN_EMAIL="steven@example.com"

# Backup automatique quotidien (app/api/cron/backup) — uniquement nécessaire
# en production (Vercel), pas pour le dev local. Voir README.md.
CRON_SECRET="random-string-generated-once"
GITHUB_TOKEN="github_pat_..."
GITHUB_BACKUP_REPO="owner/repo"
