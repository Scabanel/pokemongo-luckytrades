# Connexion Postgres (Neon via Vercel Postgres). En local, récupère les vraies
# valeurs avec `vercel env pull .env.local` (voir README.md) plutôt que de les
# taper à la main ici — utiliser POSTGRES_PRISMA_URL est le chemin recommandé
# (lib/prisma.ts retombe sur DATABASE_URL si absent).
POSTGRES_PRISMA_URL="postgres://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

ADMIN_USER="admin"
ADMIN_PASSWORD="your-secure-password"
JWT_SECRET="your-random-secret-min-32-chars"
