// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trainer {
  id         String         @id @default(uuid())
  name       String         @unique
  authUserId String?        @unique
  team       String?
  level      Int?
  createdAt  DateTime       @default(now())
  entries    PokemonEntry[]
}

// Pokémon retirés à la main par l'admin d'une section de la page publique
// "Pokémon pas encore disponibles" (app/pas-encore-sortis) - ex: une entrée
// listée à tort par les données de jeu générées (data/missing-in-go.json).
// Ne modifie jamais ces fichiers JSON eux-mêmes (régénérés périodiquement par
// le cron de rafraîchissement, voir README.md) : l'exclusion s'applique en
// filtre par-dessus, à la lecture.
model MissingPokemonExclusion {
  id        String   @id @default(uuid())
  category  String   // "missingEntirely" | "missingShiny" | "missingGigantamax" | "missingMega"
  pokemonId Int
  createdAt DateTime @default(now())

  @@unique([category, pokemonId])
}

// Pokémon ajoutés à la main par l'admin à une section de la même page
// (symétrique de MissingPokemonExclusion ci-dessus) - ex : une espèce que les
// données de jeu (data/go-icons.json) donnent à tort comme présente. Le nom
// se résout depuis data/pokemon.json via pokemonId, pas besoin de le stocker.
model MissingPokemonInclusion {
  id        String   @id @default(uuid())
  category  String   // "missingEntirely" | "missingShiny" | "missingGigantamax" | "missingMega"
  pokemonId Int
  createdAt DateTime @default(now())

  @@unique([category, pokemonId])
}

model PokemonEntry {
  id                  String   @id @default(uuid())
  pokemonName         String
  pokemonId           Int
  category            String
  trainerId           String?
  trainer             Trainer? @relation(fields: [trainerId], references: [id])
  tradeForPokemonName String?
  tradeForPokemonId   Int?
  notes               String?
  shiny               Boolean  @default(false)
  customSpriteUrl     String?
  backgroundUrl       String?
  priority            Int?
  quantity            Int      @default(1)
  tags                String?
  completed           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
