// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trainer {
  id         String         @id @default(uuid())
  name       String         @unique
  authUserId String?        @unique
  team       String?
  level      Int?
  friendCode String?
  // Obligatoire à l'inscription (voir app/api/auth/signup) ; défaut
  // "Strasbourg" pour que la migration backfill les dresseurs déjà inscrits
  // sans valeur.
  city       String         @default("Strasbourg")
  // Style de sprite par défaut appliqué à toutes ses entrées : "animated"
  // (Gen V/Showdown en premier) ou "static" (icône officielle Pokémon GO en
  // premier). Lu dynamiquement à l'affichage (voir PokemonSprite.tsx) : pas
  // besoin de migrer chaque entrée quand ce champ change, un seul update ici
  // change instantanément tous les sprites du dresseur.
  preferredSpriteStyle String?
  createdAt  DateTime       @default(now())
  entries    PokemonEntry[]
}

// Pokémon retirés à la main par l'admin d'une section de la page publique
// "Pokémon pas encore disponibles" (app/pas-encore-sortis) - ex: une entrée
// listée à tort par les données de jeu générées (data/missing-in-go.json).
// Ne modifie jamais ces fichiers JSON eux-mêmes (régénérés périodiquement par
// le cron de rafraîchissement, voir README.md) : l'exclusion s'applique en
// filtre par-dessus, à la lecture.
model MissingPokemonExclusion {
  id        String   @id @default(uuid())
  category  String   // "missingEntirely" | "missingShiny" | "missingGigantamax" | "missingMega"
  pokemonId Int
  createdAt DateTime @default(now())

  @@unique([category, pokemonId])
}

// Pokémon ajoutés à la main par l'admin à une section de la même page
// (symétrique de MissingPokemonExclusion ci-dessus) - ex : une espèce que les
// données de jeu (data/go-icons.json) donnent à tort comme présente. Le nom
// se résout depuis data/pokemon.json via pokemonId, pas besoin de le stocker.
model MissingPokemonInclusion {
  id        String   @id @default(uuid())
  category  String   // "missingEntirely" | "missingShiny" | "missingGigantamax" | "missingMega"
  pokemonId Int
  createdAt DateTime @default(now())

  @@unique([category, pokemonId])
}

model PokemonEntry {
  id                  String   @id @default(uuid())
  pokemonName         String
  pokemonId           Int
  category            String
  trainerId           String?
  trainer             Trainer? @relation(fields: [trainerId], references: [id])
  tradeForPokemonName String?
  tradeForPokemonId   Int?
  // Copie du shiny/sprite du Pokémon reçu en échange (voir linkedEntryId) :
  // sans ça, la tuile "en échange de" affiche toujours le sprite par défaut
  // (non-shiny, sans costume) même quand le Pokémon lié en est un.
  tradeForShiny           Boolean?
  tradeForCustomSpriteUrl String?
  tradePartnerName    String?
  // Lien vers l'autre entrée (à soi, catégorie opposée want/give) qui
  // représente le même échange concret : voir Item 7 du plan, synchronisé
  // dans les deux sens par les routes POST/PATCH, pas de relation Prisma
  // formelle (juste un id texte) pour rester simple sur un self-relation.
  linkedEntryId       String?
  notes               String?
  // "male" | "female" | null (non précisé/asexué) : utile pour les quelques
  // espèces à sprite différent selon le genre (Pyroar, Frillish, Indeedee...).
  gender              String?
  // "XXS" | "XS" | "XL" | "XXL" | null (taille non précisée) : les records
  // de taille (le plus petit/grand jamais capturé d'une espèce) sont
  // recherchés/échangés pour eux-mêmes en Pokémon GO, indépendamment du
  // costume/shiny. Sur un want, une taille précisée restreint le matching à
  // cette taille exacte (voir wantedSizeMatches, même principe que le fond).
  size                String?
  // Ex: Hurle-Temps sur Dialga, Onde de Choc sur Palkia... simple case à
  // cocher (pas de liste par espèce à maintenir), affiché comme badge.
  exclusiveMove       Boolean  @default(false)
  shiny               Boolean  @default(false)
  customSpriteUrl     String?
  backgroundUrl       String?
  priority            Int?
  quantity            Int      @default(1)
  tags                String?
  completed           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // GET /api/entries filtre systématiquement par completed, souvent combiné à
  // trainerId (page dresseur) ou category (catalogue par onglet) : ces index
  // évitent un scan complet de la table à mesure qu'elle grossit avec plus
  // d'utilisateurs.
  @@index([trainerId, completed])
  @@index([category, completed])
  @@index([linkedEntryId])
}
